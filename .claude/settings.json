{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(*/python *)",
      "Bash(*/python3 *)",
      "Bash(*| python *)",
      "Bash(*| python3 *)",
      "Bash(pip *)",
      "Bash(pip)",
      "Bash(pip3 *)",
      "Bash(pip3)",
      "Bash(python *)",
      "Bash(python)",
      "Bash(python3 *)",
      "Bash(python3)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/python.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/python.sh"
          }
        ]
      }
    ]
  },
  "feedbackDrafts": "off",
  "syntaxHighlightingDisabled": true,
  "effortLevel": "high",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoMemoryEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true,
  "switchModelsOnFlag": false,
  "autoCompactEnabled": false
}
